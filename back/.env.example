###############################
# APPLICATION
###############################
NODE_ENV=development
PORT=3000
# Display name used in emails; public frontend origin used to build email links
APP_NAME=Template
APP_URL=http://localhost:5173

###############################
# CENTRAL SUPERADMIN (docs/decisions.md D10)
###############################
# The key the central SuperAdmin uses to call this branch's /api/v1/manage/*.
# Unique per branch, at least 32 characters. Leave empty to keep the management
# API switched off. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# then paste the same value into SuperAdmin → Branches for this branch.
MANAGE_API_KEY=

###############################
# DATABASE (REQUIRED)
###############################
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_DATABASE=your_database_name

# Database pool configuration (optional - defaults shown)
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT=10000

###############################
# INSTALLATION (REQUIRED ON A FRESH DATABASE)
###############################
# One server + one database per TERANETWORK branch — there is no central server
# (decision D7, docs/migration/00-decisions.md). `npm run db:setup` creates the
# company, THIS installation's single branch, and its Owner / Admin / Billing /
# Technician roles from these values. Ignored once the rows exist.
COMPANY_NAME=TERANETWORK
COMPANY_EMAIL=
BRANCH_NAME=

###############################
# JWT AUTHENTICATION (REQUIRED)
###############################
jwtAuthPath=./auth-keys
jwtAuthPrivatePath=./auth-keys/private.pem
jwtAuthPublicPath=./auth-keys/public.pem
ISSUER=your-app-name
AUDIENCE=your-app-users

# Token lifetimes (optional - defaults shown)
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

###############################
# SECURITY (REQUIRED)
###############################
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=CHANGE_THIS_generate_a_random_64_character_secret_here_do_not_use_this_example_value
LOG_SALT=CHANGE_THIS_generate_a_random_32_character_salt_here_do_not_use_this_example_value

# Optional: API key for public endpoints
SECRET_KEY=

###############################
# ENCRYPTION (OPTIONAL)
###############################
# AES-256 encryption key (if using crypto.js)
cryptoKey=

###############################
# SSL/TLS (OPTIONAL)
###############################
# Path to SSL certificate directory (enables HTTPS)
certPath=

###############################
# CORS (OPTIONAL)
###############################
FRONTEND_URL=http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Cross-site CSRF cookie mode (set both to true only when the frontend is on a
# different site AND the backend is served over HTTPS)
ALLOW_CROSS_SITE_CSRF=false
COOKIE_SECURE=false
###############################
# BACKGROUND WORK
###############################
# There is NO Redis in this system. Scheduling is node-cron (in the API
# process) and the durable queue is the MySQL `jobs` table, claimed by a
# separate worker with SELECT ... FOR UPDATE SKIP LOCKED.
#
# Run the API on exactly one instance with RUN_CRON=true — cron in-process
# means two API replicas would fire every schedule twice.
RUN_CRON=true
RUN_WORKER=true

# The billing schedules live in the WORKER process, not the API — the API can
# be run as several replicas and each would fire the same cron. If the worker is
# ever scaled out, set RUN_SCHEDULER=false on every worker but one.
RUN_SCHEDULER=true

# Cron expressions, all evaluated in TIMEZONE (Asia/Manila).
# Statement day is the 15th and the dunning sweep runs at 20:00 on the due
# date: both are load-bearing business rules, not preferences. See
# docs/reference/PENDING-Billing-Model-Corrections.md before changing either.
# 09:00, not the small hours: anything that emails customers should land in an
# inbox during office hours, and a failure at 09:00 is noticed the same day.
BILLING_CYCLE_CRON=0 9 15 * *
DAILY_BILLING_CRON=0 8 * * *
DUNNING_CRON=0 20 * * *
RECONCILIATION_CRON=15 * * * *

###############################
# RATE LIMITING (OPTIONAL)
###############################
# Store type: 'memory' (single instance) | 'mysql' (clustered).
# This deploys as a single process on one on-site box, so 'memory' is correct.
# 'redis' is deliberately not an option here — there is no Redis in this stack.
RATE_LIMIT_STORE=memory
RATE_LIMIT_KEY_PREFIX=rl

# Profile overrides (optional - defaults shown)
# API: General requests
RATE_LIMIT_API_POINTS=100
RATE_LIMIT_API_DURATION=900
RATE_LIMIT_API_BLOCK=0

# Auth: Login/Register (stricter)
RATE_LIMIT_AUTH_POINTS=10
RATE_LIMIT_AUTH_DURATION=900
RATE_LIMIT_AUTH_BLOCK=900

# Upload: File uploads
RATE_LIMIT_UPLOAD_POINTS=20
RATE_LIMIT_UPLOAD_DURATION=3600
RATE_LIMIT_UPLOAD_BLOCK=0

# Password Reset (very strict)
RATE_LIMIT_PWRESET_POINTS=3
RATE_LIMIT_PWRESET_DURATION=3600
RATE_LIMIT_PWRESET_BLOCK=3600

# CSRF Token generation
RATE_LIMIT_CSRF_POINTS=30
RATE_LIMIT_CSRF_DURATION=900
RATE_LIMIT_CSRF_BLOCK=0

# Strict: Sensitive operations
RATE_LIMIT_STRICT_POINTS=5
RATE_LIMIT_STRICT_DURATION=3600
RATE_LIMIT_STRICT_BLOCK=7200

###############################
# EMAIL / SMTP (OPTIONAL)
###############################
# Leave SMTP_HOST blank in development — emails are logged to the console
# (nodemailer JSON transport) instead of being sent, so no keys are needed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TERANETWORK <no-reply@teranetwork.ph>

# Where the customer-facing payment page lives. Every invoice email and printed
# QR encodes PUBLIC_APP_URL/pay/<token>, so this must be the address customers
# can actually reach from outside — not localhost, in production.
PUBLIC_APP_URL=http://localhost:5173

###############################
# PAYMENT GATEWAY (OPTIONAL)
###############################
# Which adapter collects money. Adapters live in
# server/src/lib/payment-gateways/ — adding a provider is a new file there plus
# a case in index.js, and nothing else in the codebase changes.
#
# Credentials are read from the environment rather than from system_settings,
# and that is deliberate: a callback arrives before we know whose it is, so
# verifying it cannot depend on a tenant lookup without becoming circular. The
# System settings screen shows which provider is live; it does not hold the key.
#
# 'mock' is a working gateway that keeps its money in memory. It signs its
# callbacks, speaks centavos, and drives the real webhook endpoint — so the
# whole payment path is clickable with no merchant account.
PAYMENT_PROVIDER=mock

# Signs and verifies mock callbacks. WITHOUT THIS THE MOCK IS DISABLED, on
# purpose: an unconfigured deployment must never accept an unsigned "invoice
# paid" from anyone who finds the webhook URL.
PAYMENT_MOCK_SECRET=

# How long a checkout link stays valid. 30 days by default — an invoice is
# issued on the 15th and falls due on the 2nd, so a shorter window strands
# customers who pay late.
PAYMENT_EXPIRY_SECONDS=2592000

###############################
# FILE VALIDATION (OPTIONAL)
###############################
STRICT_FILE_VALIDATION=true
SCAN_MALWARE_PATTERNS=true
ALLOW_PRIVATE_IPS=false
EXTERNAL_API_WHITELIST=api.example.com

###############################
# TIMEZONE (OPTIONAL)
###############################
# Display timezone. Storage is Asia/Manila local (see docs/schema-conventions.md).
TIMEZONE=Asia/Manila

###############################
# ISP — CREDENTIAL ENCRYPTION (REQUIRED)
###############################
# Master key wrapping the per-record data keys that encrypt OLT and MikroTik
# credentials at rest. Rotating it makes every stored credential unreadable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_MASTER_KEY=

###############################
# ISP — BILLING (OPTIONAL)
###############################
# VAT is 0% today, behind a setting so it can be flipped to 0.12 without a
# deploy. Runtime-tunable values (GRACE_DAYS, DRY_RUN) live in the
# system_settings table, not here — they must be changeable without a restart.
VAT_RATE=0

# Public base URL for the customer invoice page. Every emailed link and QR
# encodes PAY_BASE_URL/<token> — never a raw gateway URL — so the link keeps
# working after the gateway's own payment link expires.
PAY_BASE_URL=http://localhost:5173/pay

###############################
# ISP — HITPAY (PARKED)
###############################
# PARKED as of 2026-09-16 (decision D8): GCash Business is the acting payment
# method. The adapter stays in the codebase, tested, for when the client adopts
# HitPay; leave these blank until then. A branch may override
# the company default above with `branches.paymentProvider`; the credentials
# below are shared by every branch collecting through HitPay, because secrets
# live here rather than in the database. Two branches on the same provider
# therefore share one merchant account, which is what the client wants today.
#
# Both values come from the HitPay dashboard, Settings > API Keys. They are
# DIFFERENT values and both are required: with only the key you get a working
# checkout whose every callback is rejected as an invalid signature.
PAYMENT_HITPAY_API_KEY=
# Signs and verifies callbacks. Verification FAILS CLOSED when this is unset:
# an unconfigured deployment must never accept an unsigned "invoice paid" from
# whoever finds the webhook URL.
PAYMENT_HITPAY_SALT=
# 'sandbox' or 'live'. Defaults to sandbox when unset, on purpose — a missing
# variable must not quietly point a fresh deployment at real money.
PAYMENT_HITPAY_MODE=sandbox
#
# Register the callback URL in the HitPay dashboard under
# Developers > Webhook Endpoints, subscribing to `payment_request.completed`:
#
#   <PUBLIC_APP_URL>/api/v1/public/webhooks/hitpay
#
# The provider slug in that path is what tells verification which secret to
# use, which is why a callback can be checked before we know whose invoice it
# is. See server/src/lib/payment-gateways/README.md.

###############################
# ISP — GCASH BUSINESS (ACTING PAYMENT METHOD — NOT YET BUILT)
###############################
# Decision D8 / docs/gcash-payment-flow.md. The client's reusable GCash Business
# MERCHANT QR goes on every invoice; the subscriber scans it and pays; the
# system later matches the GCash transaction to the invoice. There is no
# per-invoice QR and no checkout session.
#
# No keys are defined here yet ON PURPOSE. How transactions are retrieved (an
# API, a report export, a manual entry screen) depends on the GCash Business
# product the client is approved for, and is not guessed. Setting
# PAYMENT_PROVIDER to 'gcash' today resolves to a 501. A public webhook URL is
# NOT a requirement unless that product's documentation says GCash calls us.

###############################
# ISP — OLT / DEVICE (OPTIONAL)
###############################
# Mock driver behaviour, for exercising the disconnect/reconnect flow without
# hardware. Failure rate is 0..1 — set it above 0 to rehearse retry and
# dead-letter handling.
MOCK_OLT_LATENCY_MS=250
MOCK_OLT_FAILURE_RATE=0
