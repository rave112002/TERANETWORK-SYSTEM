{
  "name": "template",
  "version": "1.0.0",
  "description": "Template API",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./server/bin/www.js",
    "dev": "nodemon ./server/bin/www.js",
    "worker": "node ./server/bin/worker.js",
    "worker:dev": "nodemon ./server/bin/worker.js",
    "pm2:start": "sudo pm2 start ecosystem.config.cjs",
    "pm2:prod": "sudo pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "sudo pm2 reload ecosystem.config.cjs",
    "pm2:stop": "sudo pm2 stop ecosystem.config.cjs",
    "lint": "eslint \"server/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"server/**/*.{js,jsx}\" --fix",
    "format": "prettier --write \"server/**/*.js\"",
    "format:check": "prettier --check \"server/**/*.js\"",
    "db:setup": "node scripts/setup-database.js",
    "db:setup:clean": "node scripts/setup-database-clean.js",
    "db:migrate": "node scripts/migrate.js",
    "db:reset": "node scripts/reset-database.js",
    "db:check": "node scripts/check-database.js",
    "keys": "node scripts/generate-keys.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Alfie Garing",
  "license": "ISC",
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "argon2": "^0.41.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.5.48",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^9.0.1",
    "sanitize-html": "^2.15.0",
    "sharp": "^0.35.4",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xendit-node": "^7.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.8.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.7.4",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
