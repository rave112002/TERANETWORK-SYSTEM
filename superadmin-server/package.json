{
  "name": "teranetwork-superadmin-server",
  "version": "1.0.0",
  "description": "The central SuperAdmin server: runs on the developer's PC and manages every branch over Tailscale (docs/decisions.md D10).",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "user": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/user.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
