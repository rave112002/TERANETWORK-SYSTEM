# Central SuperAdmin server (docs/decisions.md D10). Copy to .env on the SuperAdmin PC.

# Encrypts the branch keys stored in data/superadmin.db. At least 32 characters.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep a copy somewhere safe: if it is lost or changed, every branch key must be entered again.
SUPERADMIN_SECRET=

# 127.0.0.1 = only this PC can open SuperAdmin. Use the PC's Tailscale IP to open it from another device.
HOST=127.0.0.1
PORT=8788

# Where superadmin.db lives (relative to this folder).
DATA_DIR=data

# The built web app (front: npm run build:superadmin).
WEB_DIST=../front/dist-superadmin

# true only when SuperAdmin is served over HTTPS.
COOKIE_SECURE=false

SESSION_HOURS=12
BRANCH_TIMEOUT_MS=5000
